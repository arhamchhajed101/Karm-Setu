# KarmSetu Backend Environment Variables
PROJECT_NAME="KarmSetu Backend"
API_V1_STR="/api/v1"
SECRET_KEY="karmsetu-super-secret-production-key-sih-2026-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database: Default SQLite for easy zero-config local run; swap to PostgreSQL/Supabase anytime
DATABASE_URL="sqlite:///./karmsetu.db"
# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/karmsetu"

# CORS Origins (allow frontend dev servers like Next.js localhost:3000)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://localhost:8000"]
